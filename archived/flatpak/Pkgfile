version="1.15.12"
desc="Linux application sandboxing and distribution framework"
makedeps=["zstd", "systemd", "curl", "libxml2", "libseccomp", "ostree", "libarchive", "json-glib", "gdk-pixbuf", "fuse3", "appstream", "wayland-protocols", "gobject-introspection"]
deps=["zstd", "systemd", "curl", "libxml2", "libseccomp", "ostree", "libarchive", "json-glib", "gdk-pixbuf", "fuse3", "appstream", "wayland"]
source=[
	{url="https://github.com/flatpak/flatpak/releases/download/$version/flatpak-$version.tar.xz"},
	{url="skip-gpgme.patch"},
]

ext='''
	cd flatpak-$version
	patch -Np1 -i "$srcdir/skip-gpgme.patch"
	sed -i '/gpgme/d' meson.build common/meson.build
'''

build='''
	python -m venv ss
	. ss/bin/activate
	pip install pyparsing
	noname-meson flatpak-$version build -Ddconf=disabled -Dmalcontent=disabled -Dsystem_helper=disabled -Dxauth=disabled \
	-Dgtkdoc=disabled -Dselinux_module=disabled -Ddocbook_docs=disabled -Dman=disabled -Dtests=false --wrap-mode default
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
