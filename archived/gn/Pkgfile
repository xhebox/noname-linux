version="0.2207"
desc='Meta-build system that generates build files for Ninja'
makedeps=["python3", "llvm", "ninja"]
source=[{url="https://gn.googlesource.com/gn", protocol="git", commit="ed1abc107815210dc66ec439542bee2f6cbabc00"}]

build='''
	cd gn
	python ./build/gen.py --no-static-libstdc++ --no-strip --allow-warnings
	ninja -C out gn
	install -D out/gn "$pkgdir/bin/gn"
'''
