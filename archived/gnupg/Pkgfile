version="1.24.1"
deps=["openssl", "libgpg-error", "libassuan"]
makedeps=["openssl", "libgpg-error", "libassuan"]
source=[{url="https://www.gnupg.org/ftp/gcrypt/gpgme/gpgme-$version.tar.bz2"}]

build='''
	cd gpgme-$version

	./configure --prefix= --disable-fd-passing --disable-static \
              --disable-gpgsm-test
	make
	make DESTDIR="$pkgdir" install
'''
