version="3.8.8"
desc="A library that provides a secure layer over a reliable transport layer"
deps=["nettle", "zlib", "libtasn1", "p11-kit"]
makedeps=["nettle", "zlib", "libtasn1", "p11-kit"]
source=[{url="http://www.ring.gr.jp/pub/net/gnupg/$name/v${version%.*}/$name-${version}.tar.xz"}]

build='''
	cd gnutls-$version
	./configure --prefix=/ --disable-static \
	--with-included-unistring \
	--without-idn \
	--with-p11-kit \
	--with-zlib \
	--disable-guile

	make
	make DESTDIR="$pkgdir" install
'''
