version="1.51"
desc="Support library for libgcrypt"
deps=["musl", "dash"]
source=[
  {url="https://gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-${version}.tar.bz2"}
]

build='''
  cd libgpg-error-$version
  ./configure --prefix=
	truncate -s 0 src/gpg-error-config-test.sh
  make
  make DESTDIR="$pkgdir" install
'''
