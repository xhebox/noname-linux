version="2024.9"
desc="Operating system and container binary deployment and upgrades"
makedeps=["systemd", "openssl", "xz", "libarchive", "glib", "curl", "gobject-introspection"]
deps=["systemd", "openssl", "xz", "libarchive", "glib", "curl"]
source=[
	{url="https://github.com/ostreedev/ostree/releases/download/v$version/libostree-$version.tar.xz"},
]

build='''
	cd libostree-$version
	./configure --prefix= --libexecdir=/lib --sbindir=/bin --without-soup --with-curl --without-gpgme --without-avahi --disable-glib-test --disable-gtk-doc-html
	sed -i 's;CC=gcc;;g' Makefile
	make
	make DESTDIR="$pkgdir" install 
'''
