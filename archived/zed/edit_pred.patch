diff --git a/crates/deepseek/src/edit_prediction_provider.rs b/crates/deepseek/src/edit_prediction_provider.rs
new file mode 100644
index 0000000000..ff8632c9da
--- /dev/null
+++ b/crates/deepseek/src/edit_prediction_provider.rs
@@ -0,0 +1,241 @@
+use anyhow::{Context as _, Result};
+use edit_prediction_context::{EditPredictionExcerpt, EditPredictionExcerptOptions};
+use edit_prediction_types::{EditPrediction, EditPredictionDelegate, interpolate_edits};
+use futures::AsyncReadExt;
+use gpui::{App, Context, Entity, Task};
+use http_client::{AsyncBody, HttpClient, Method, Request as HttpRequest};
+use language::{language_settings::all_language_settings, Anchor, Buffer, BufferSnapshot, EditPreview, ToPoint};
+use serde_json::Value;
+use std::{
+    ops::Range,
+    sync::Arc,
+    time::Duration,
+};
+use text::ToOffset;
+
+pub const DEBOUNCE_TIMEOUT: Duration = Duration::from_millis(150);
+
+const EXCERPT_OPTIONS: EditPredictionExcerptOptions = EditPredictionExcerptOptions {
+    max_bytes: 1050,
+    min_bytes: 525,
+    target_before_cursor_over_total_bytes: 0.66,
+};
+
+/// Represents a completion that has been received and processed from DeepSeek.
+#[derive(Clone)]
+struct CurrentCompletion {
+    snapshot: BufferSnapshot,
+    edits: Arc<[(Range<Anchor>, Arc<str>)]>,
+    edit_preview: EditPreview,
+}
+
+impl CurrentCompletion {
+    fn interpolate(&self, new_snapshot: &BufferSnapshot) -> Option<Vec<(Range<Anchor>, Arc<str>)>> {
+        interpolate_edits(&self.snapshot, new_snapshot, &self.edits)
+    }
+}
+
+pub struct DeepseekEditPredictionProvider {
+    http_client: Arc<dyn HttpClient>,
+    pending_request: Option<Task<Result<()>>>,
+    current_completion: Option<CurrentCompletion>,
+    api_url: String,
+    model_name: String,
+    api_key: String,
+}
+
+impl DeepseekEditPredictionProvider {
+    pub fn new(http_client: Arc<dyn HttpClient>, api_url: &str, model_name: &str, api_key: &str) -> Self {
+        Self {
+            http_client,
+            pending_request: None,
+            current_completion: None,
+            api_url: api_url.to_string(),
+            api_key: api_key.to_string(),
+            model_name: match model_name {
+                "" => "deepseek-chat".into(),
+                _ => model_name.to_string(),
+            },
+        }
+    }
+
+    async fn fetch_completion(
+        http_client: Arc<dyn HttpClient>,
+        api_key: &str,
+        prompt: String,
+        suffix: String,
+        model: String,
+        max_tokens: Option<u32>,
+        api_url: String,
+    ) -> Result<String> {
+        let body = serde_json::json!({
+            "model": model,
+            "prompt": prompt,
+            "suffix": if suffix.is_empty() { None } else { Some(suffix) },
+            "max_tokens": max_tokens.unwrap_or(350),
+            "temperature": 0.2,
+        });
+
+        let request = HttpRequest::builder()
+            .method(Method::POST)
+            .uri(format!("{}/completions", api_url))
+            .header("Content-Type", "application/json")
+            .header("Authorization", format!("Bearer {}", api_key))
+            .body(AsyncBody::from(body.to_string()))?;
+
+        let mut response = http_client.send(request).await?;
+        let mut body = String::new();
+        response.body_mut().read_to_string(&mut body).await?;
+
+        let data: Value = serde_json::from_str(&body)?;
+        let text = &data["choices"][0]["text"];
+        Ok(text.as_str().unwrap_or("").to_string())
+    }
+}
+
+impl EditPredictionDelegate for DeepseekEditPredictionProvider {
+    fn name() -> &'static str {
+        "deepseek"
+    }
+
+    fn display_name() -> &'static str {
+        "DeepSeek"
+    }
+
+    fn show_predictions_in_menu() -> bool {
+        true
+    }
+
+    fn is_refreshing(&self, _cx: &App) -> bool {
+        self.pending_request.is_some() && self.current_completion.is_none()
+    }
+
+    fn is_enabled(&self, _buffer: &Entity<Buffer>, _cursor_position: Anchor, _cx: &App) -> bool {
+        !self.api_key.is_empty()
+    }
+
+    fn refresh(
+        &mut self,
+        buffer: Entity<Buffer>,
+        cursor_position: language::Anchor,
+        debounce: bool,
+        cx: &mut Context<Self>,
+    ) {
+        let snapshot = buffer.read(cx).snapshot();
+
+        // Check if current completion is still valid
+        if let Some(current_completion) = self.current_completion.as_ref() {
+            if current_completion.interpolate(&snapshot).is_some() {
+                return;
+            }
+        }
+
+        let http_client = self.http_client.clone();
+        let api_key = self.api_key.clone();
+        let model = self.model_name.clone();
+        let api_url = self.api_url.clone();
+        let max_tokens = all_language_settings(None, cx)
+            .edit_predictions
+            .deepseek
+            .max_tokens;
+
+        self.pending_request = Some(cx.spawn(async move |this, cx| {
+            if debounce {
+                cx.background_executor().timer(DEBOUNCE_TIMEOUT).await;
+            }
+
+            let cursor_offset = cursor_position.to_offset(&snapshot);
+            let cursor_point = cursor_offset.to_point(&snapshot);
+            let excerpt = EditPredictionExcerpt::select_from_buffer(
+                cursor_point,
+                &snapshot,
+                &EXCERPT_OPTIONS,
+            )
+            .context("Line containing cursor doesn't fit in excerpt max bytes")?;
+
+            let excerpt_text = excerpt.text(&snapshot);
+            let cursor_within_excerpt = cursor_offset
+                .saturating_sub(excerpt.range.start)
+                .min(excerpt_text.body.len());
+            let prompt = excerpt_text.body[..cursor_within_excerpt].to_string();
+            let suffix = excerpt_text.body[cursor_within_excerpt..].to_string();
+
+            let completion_text = match Self::fetch_completion(
+                http_client,
+                &api_key,
+                prompt,
+                suffix,
+                model,
+                max_tokens,
+                api_url,
+            )
+            .await
+            {
+                Ok(text) => text,
+                Err(e) => {
+                    log::error!("DeepSeek: Failed to fetch completion: {}", e);
+                    this.update(cx, |this, cx| {
+                        this.pending_request = None;
+                        cx.notify();
+                    })?;
+                    return Err(e);
+                }
+            };
+
+            if completion_text.trim().is_empty() {
+                this.update(cx, |this, cx| {
+                    this.pending_request = None;
+                    cx.notify();
+                })?;
+                return Ok(());
+            }
+
+            let edits: Arc<[(Range<Anchor>, Arc<str>)]> =
+                vec![(cursor_position..cursor_position, completion_text.clone().into())].into();
+            let edit_preview = buffer
+                .read_with(cx, |buffer, cx| buffer.preview_edits(edits.clone(), cx))?
+                .await;
+
+            this.update(cx, |this, cx| {
+                this.current_completion = Some(CurrentCompletion {
+                    snapshot,
+                    edits,
+                    edit_preview,
+                });
+                this.pending_request = None;
+                cx.notify();
+            })?;
+
+            Ok(())
+        }));
+    }
+
+    fn accept(&mut self, _cx: &mut Context<Self>) {
+        self.pending_request = None;
+        self.current_completion = None;
+    }
+
+    fn discard(&mut self, _cx: &mut Context<Self>) {
+        self.pending_request = None;
+        self.current_completion = None;
+    }
+
+    fn suggest(
+        &mut self,
+        buffer: &Entity<Buffer>,
+        _cursor_position: Anchor,
+        cx: &mut Context<Self>,
+    ) -> Option<EditPrediction> {
+        let current_completion = self.current_completion.as_ref()?;
+        let buffer = buffer.read(cx);
+        let edits = current_completion.interpolate(&buffer.snapshot())?;
+        if edits.is_empty() {
+            return None;
+        }
+        Some(EditPrediction::Local {
+            id: None,
+            edits,
+            edit_preview: Some(current_completion.edit_preview.clone()),
+        })
+    }
+}
