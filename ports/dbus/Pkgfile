version="1.16.0"
deps=["expat", "util-linux", "systemd"]
makedeps=["expat", "util-linux", "python3", "systemd"]
desc="Freedesktop.org message bus system"
source=[
	{url="http://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"},
	{url="dbus.sysusers"},
]

ext='''
	cd dbus-$version
	for i in $source;do
		echo $i
		case $i in
		*patch) patch -p1 -i "$srcdir"/$i;;
		esac
	done
'''

build='''
	noname-meson dbus-$version build -Dapparmor=disabled -Ddbus_user=dbus -Dkqueue=disabled -Dlaunchd=disabled -Drelocation=disabled -Dselinux=disabled -Dx11_autolaunch=disabled \
	-Dxml_docs=disabled -Ddoxygen_docs=disabled -Dducktype_docs=disabled -Dqt_help=disabled -Dlibaudit=disabled
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
	install -Dm644 "$srcdir"/dbus.sysusers "$pkgdir"/lib/sysusers.d/dbus.conf
'''
