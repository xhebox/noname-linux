version="2.7.0"
_version="`echo $version | tr '.' '_'`"
deps=["musl"]
desc="A fast, non-validating, stream-oriented XML parsing library"
source=[{url="https://github.com/libexpat/libexpat/releases/download/R_$_version/expat-$version.tar.gz"}]

build='''
	 cd expat-$version
	 ./configure --prefix= --disable-static
	 make 
	 make DESTDIR="$pkgdir" install 
'''
