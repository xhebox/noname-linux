version="1.25"
desc="GNU dbm is a set of database routines that use extensible hashing"
deps=["dash", "musl"]
source=[
	{url="http://mirrors.ustc.edu.cn/gnu/gdbm/gdbm-$version.tar.gz"},
	{url="musl.patch"},
]

ext='''
	cd gdbm-$version
	patch -Np1 -i "$srcdir"/musl.patch
'''

build='''
	cd gdbm-$version
	export CFLAGS="$CFLAGS -Wno-implicit-int"
	./configure \
		--prefix= \
		--enable-libgdbm-compat --disable-rpath
	make
	make DESTDIR="$pkgdir" install

	# create symlinks for compatibility
	install -dm755 "$pkgdir/include/gdbm"
	ln -sf ../gdbm.h "$pkgdir/include/gdbm/gdbm.h"
	ln -sf ../ndbm.h "$pkgdir/include/gdbm/ndbm.h"
	ln -sf ../dbm.h	"$pkgdir/include/gdbm/dbm.h"
'''
