version="1.25.90"
desc="Multimedia graph framework - core"
url="https://gstreamer.freedesktop.org/"
makedeps=["libxml2", "glib", "libcap", "elfutils", "alsa-lib", "libvorbis", "libpng", "libtheora", "pango", "libjpeg-turbo", "zlib", "iso-codes", "libogg", "graphene", "wayland-protocols", "vulkan-headers", "python3", "gobject-introspection"]
deps=["libxml2", "glib", "libcap", "elfutils", "alsa-lib", "libvorbis", "libpng", "libtheora", "pango", "libjpeg-turbo", "zlib", "iso-codes", "libogg", "graphene", "wayland", "vulkan"]
source=[{url="https://gitlab.freedesktop.org/gstreamer/gstreamer/-/archive/${version}/gstreamer-${version}.tar.gz"}]

build='''
	export CFLAGS="$CFLAGS -D_GNU_SOURCE"
	export CXXFLAGS="$CXXFLAGS -D_GNU_SOURCE"
	noname-meson gstreamer-$version build \
		-D good=disabled \
		-D bad=disabled \
		-D ugly=disabled \
		-D doc=disabled \
		-D gstreamer:libunwind=disabled \
		-D gstreamer:dbghelp=disabled \
		-D gstreamer:bash-completion=disabled \
		-D gst-plugins-base:gl-graphene=enabled \
		-D gst-plugins-base:tremor=disabled \
		-D gst-plugins-base:cdparanoia=disabled \
		-D gst-plugins-base:x11=disabled \
		-D gst-plugins-base:xshm=disabled \
		-D gst-plugins-base:introspection=disabled \
		-D gst-plugins-base:libvisual=disabled \
		-D gst-plugins-base:orc=disabled \
		-D gst-plugins-base:opus=disabled \
		-D gst-plugins-base:xi=disabled \
		-D gst-plugins-base:xshm=disabled \
		-D gst-plugins-base:xvideo=disabled \
		-D gst-examples=disabled \
    -D gst-plugins-bad:aja=disabled \
    -D gst-plugins-bad:amfcodec=disabled \
    -D gst-plugins-bad:directfb=disabled \
    -D gst-plugins-bad:directshow=disabled \
    -D gst-plugins-bad:directsound=disabled \
    -D gst-plugins-bad:flite=disabled \
    -D gst-plugins-bad:gs=disabled \
    -D gst-plugins-bad:iqa=disabled \
    -D gst-plugins-bad:isac=disabled \
    -D gst-plugins-bad:magicleap=disabled \
    -D gst-plugins-bad:cuda-nvmm=disabled \
    -D gst-plugins-bad:opencv=disabled \
    -D gst-plugins-bad:mfx_api=oneVPL \
    -D gst-plugins-bad:openni2=disabled \
    -D gst-plugins-bad:opensles=disabled \
    -D gst-plugins-bad:x11=disabled \
    -D gst-plugins-bad:vulkan-video=disabled \
    -D gst-plugins-bad:webrtc=disabled \
    -D gst-plugins-bad:webrtcdsp=disabled \
    -D gst-plugins-bad:qt6d3d11=disabled \
    -D gst-plugins-bad:tinyalsa=disabled \
    -D gst-plugins-bad:voaacenc=disabled \
    -D gst-plugins-bad:voamrwbenc=disabled \
    -D gst-plugins-bad:wasapi2=disabled \
    -D gst-plugins-bad:wasapi=disabled \
    -D gst-plugins-bad:wic=disabled \
    -D gst-plugins-bad:win32ipc=disabled \
    -D gst-plugins-base:libvisual=disabled \
    -D gst-plugins-base:tremor=disabled \
    -D gst-plugins-good:rpicamsrc=disabled \
    -D gst-plugins-ugly:sidplay=disabled \
		-D python=disabled \
		-D devtools=disabled \
		-D sharp=disabled \
		-D ges=disabled \
		-D libnice=disabled \
		-D orc=disabled \
		-D gpl=enabled \
		-D gtk_doc=disabled \
		-D introspection=enabled \
		-D webrtc=enabled \
		-D package-name="GStreamer (Noname Linux)"
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
