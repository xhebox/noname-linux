version="34"
desc="Kernel module utilities and library"
deps=["zlib", "xz", "zstd"]
makedeps=["zlib", "xz", "zstd"]
source=[
	{url="https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-$version.tar.xz"},
	{url="depmod-search.conf"},
	{url="depmod.toml"},
]

build='''
	noname-meson kmod-$version build -Dmanpages=false
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build

	install -d "$pkgdir"/etc/modprobe.d
	install -d "$pkgdir"/etc/depmod.d
	install -Dm755 "$srcdir"/depmod.toml "$pkgdir/${HOOKS#$ROOT}"/depmod.toml
	install -Dm644 "$srcdir/depmod-search.conf" "$pkgdir/lib/depmod.d/search.conf"
'''
