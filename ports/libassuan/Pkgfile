version="3.0.0"
deps=["libgpg-error"]
makedeps=["libgpg-error"]
desc="Interprocess communication library used by some GnuPG components"
source=[{url="https://www.gnupg.org/ftp/gcrypt/libassuan/libassuan-$version.tar.bz2"}]

build='''
	cd libassuan-$version
	./configure --prefix=
	make
	make DESTDIR="$pkgdir" install
'''
