version="1.1.8"
desc="X11 font encoding library"
makedeps=["zlib", "xorgproto", "util-macros"]
deps=["zlib"]
source=[{url="https://www.x.org/pub/individual/lib/libfontenc-$version.tar.xz"}]

build='''
	cd libfontenc-$version
	./configure --prefix= --sysconfdir=/etc --localstatedir=/var --disable-static 
	make
	make DESTDIR="$pkgdir" install
'''
