version="1.3.4"
desc="The GL Vendor-Neutral Dispatch library"
makedeps=["libx11", "libxext", "python3", "meson", "xorgproto"]
deps=["libx11", "libxext"]
source=[
	{url="https://gitlab.freedesktop.org/glvnd/libglvnd/-/archive/v${version}/libglvnd-v${version}.tar.gz"},
]

ext='''
	cd libglvnd-v$version
'''

build='''
	noname-meson libglvnd-v$version build -Dgles1=false -Dtls=disabled
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
