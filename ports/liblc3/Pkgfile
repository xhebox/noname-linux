version="1.1.3"
desc="LE AUDIO"
makedeps=["musl", "meson"]
deps=["musl"]
source=[
	{url="https://github.com/google/liblc3/archive/refs/tags/v$version.tar.gz"},
]

build='''
	noname-meson liblc3-$version build -Dpython=false -Dtools=true
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
