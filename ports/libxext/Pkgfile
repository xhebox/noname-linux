version="1.3.6"
desc="Common X extensions client library"
makedeps=["util-macros", "xorgproto", "libxau", "libx11"]
deps=["libxau", "libx11"]
source=[{url="https://xorg.freedesktop.org/releases/individual/lib/libXext-$version.tar.xz"}]

build='''
	cd libXext-$version
	./configure --prefix=
	make
	make DESTDIR="$pkgdir" install
'''
