version="2.15.1"
desc="XML library version 2"
makedeps=["ncurses", "readline", "xz", "zlib"]
deps=["ncurses", "readline", "xz", "zlib"]
source=[{url="https://download.gnome.org/sources/libxml2/${version%.*}/libxml2-$version.tar.xz"}]

build='''
	cd libxml2-$version 
	./configure --prefix= --without-python --without-icu --with-threads --with-history
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0 /g' libtool
	PYTHONHASHSEED=0 make
	find doc -type f -exec chmod 0644 {} +
	make DESTDIR="$pkgdir" install
'''
