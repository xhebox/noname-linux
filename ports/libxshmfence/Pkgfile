version="1.3.3"
desc="a library that exposes a event API on top of Linux futexes"
makedeps=["xorgproto", "util-macros"]
source=[{url="https://www.x.org/pub/individual/lib/libxshmfence-$version.tar.xz"}]

build='''
	cd libxshmfence-$version
	./configure --prefix= --sysconfdir=/etc --localstatedir=/var --disable-static 
	make
	make DESTDIR="$pkgdir" install
'''
