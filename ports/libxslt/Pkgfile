version="1.1.45"
desc="XSL Transformations library."
makedeps=["python3", "libxml2"]
deps=["libxml2"]
source=[{url="https://download.gnome.org/sources/libxslt/${version%.*}/libxslt-$version.tar.xz"}]

build='''
	cd libxslt-$version
	./configure --prefix=/ --with-python=/bin/python
	sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
	make DESTDIR=$pkgdir install
'''
