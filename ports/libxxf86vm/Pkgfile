version="1.1.6"
desc="X11 XFree86 video mode extension library"
makedeps=["libxext", "libx11", "xorgproto"]
deps=["libxext", "libx11"]
source=[{url="https://xorg.freedesktop.org/releases/individual/lib/libXxf86vm-$version.tar.xz"}]

build='''
	cd libXxf86vm-$version
	./configure --prefix= --disable-static
	make
	make DESTDIR="$pkgdir" install
'''
