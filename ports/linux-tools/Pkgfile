version="6.14.4"
xanmod="1"
desc="Linux kernel tools"
source=[
	{url="https://cdn.kernel.org/pub/linux/kernel/v${version%%.*}.x/linux-${version}.tar.xz"},
	{url="musl.patch"},
]
makedeps=["perl", "python3", "pciutils", "glib", "sysfsutils", "elfutils", "zlib", "systemd", "openssl", "xz", "binutils", "libtraceevent"]
deps=["perl", "python3", "pciutils", "glib", "sysfsutils", "elfutils", "zlib", "systemd", "openssl", "xz", "binutils", "libtraceevent"]

ext='''
	cd linux-${version}
	patch -p0 -i ../musl.patch
'''

build='''
	cd linux-${version}

	compiler_flags="LLVM=1"

	echo 'tmon'
	cd tools/thermal/tmon
	make $compiler_flags
	make $compiler_flags install BINDIR=bin INSTALL_ROOT="$pkgdir"
	cd -

	echo 'perf'
	cd tools/perf
	make -f Makefile.perf \
	prefix=/ \
	lib=lib/perf \
	perfexecdir=lib/perf \
	$compiler_flags \
	EXTRA_CFLAGS=' -Wno-error=bad-function-cast -Wno-error=declaration-after-statement -Wno-error=implicit-function-declaration -Wno-error=switch-enum' \
	NO_LIBBPF=1 \
	NO_SDT=1 \
	all

	make -f Makefile.perf \
	DESTDIR="$pkgdir" \
	prefix=/ \
	lib=lib/perf \
	perfexecdir=lib/perf \
	$compiler_flags \
	EXTRA_CFLAGS=' -Wno-error=bad-function-cast -Wno-error=declaration-after-statement -Wno-error=implicit-function-declaration -Wno-error=switch-enum' \
	NO_LIBBPF=1 \
	NO_SDT=1 \
	install
	cd -

	echo 'cpupower'
	cd tools/power/cpupower
	make VERSION=$version $compiler_flags
	make \
	$compiler_flags \
	DESTDIR="$pkgdir" \
	bindir='/bin' \
	sbindir='/bin' \
	bash_completion_dir= '/share/bash-completion/completions' \
	libdir='/lib' \
	includedir='/include' \
	mandir='/share/man' \
	localedir='/share/locale' \
	docdir='/share/doc/cpupower' \
	install install-man
	cd -

	echo 'usbip'
	cd tools/usb/usbip
	./autogen.sh
	./configure --prefix=/ --sbindir=/bin
	make $compiler_flags
	make $compiler_flags install DESTDIR="$pkgdir"
	cd -
'''
