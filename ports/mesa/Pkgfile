version="25.1.5"
makedeps=["expat", "libdrm", "elfutils", "llvm", "libclc", "lm_sensors", "libva", "zstd", "spirv-llvm", "libx11", "libxcb", "libxext", "libxshmfence", "libxfixes", "libxxf86vm", "libglvnd", "vulkan", "wayland-protocols", "vulkan-headers"]
deps=["expat", "libdrm", "elfutils", "llvm", "libclc", "lm_sensors", "libva", "zstd", "spirv-llvm", "libx11", "libxcb", "libxext", "libxshmfence", "libxfixes", "libxxf86vm", "libglvnd", "vulkan", "wayland"]
desc="Mesa 3D Graphics Library"
source=[
	{url="https://archive.mesa3d.org/mesa-$version.tar.xz"},
	{url="no-isystem.patch"},
	{url="musl.patch"},
	{url="musl-stacksize.patch"},
	{url="musl-endian.patch"},
]

ext='''
	cd mesa-$version
	for i in $source; do
		echo $i
		case $i in
		add-*patch|musl*patch) patch -p0 -i "$srcdir"/$i ;;
		*patch)	patch -Nbp1 -i "$srcdir"/$i ;;
		esac
	done
	for i in src/intel/genxml src/intel/vulkan/grl/include; do
		cp /lib/clang/*/include/opencl-c-base.h \
			/lib/clang/*/include/opencl-c.h \
			$i 
	done
'''

build='''
	python3 -m venv --system-site-packages ss
	. ./ss/bin/activate
	pip install mako ply PyYAML
	ulimit -n 100000
	noname-meson mesa-$version build \
		-D b_ndebug=true \
		-D platforms=x11,wayland \
		-D gallium-drivers=i915,crocus,iris,zink,nouveau,radeonsi,llvmpipe,softpipe \
		-D vulkan-drivers=swrast,amd,intel,intel_hasvk,virtio \
		-D vulkan-layers=device-select,overlay,intel-nullhw \
		-D egl=enabled \
		-D intel-rt=enabled \
		-D gallium-extra-hud=true \
		-D gallium-vdpau=disabled \
		-D gallium-va=enabled \
		-D microsoft-clc=disabled \
		-D intel-clc=auto \
		-D android-libbacktrace=disabled \
		-D gbm=enabled \
		-D gles1=disabled \
		-D gles2=enabled \
		-D glx=dri \
		-D glvnd=enabled \
		-D llvm=enabled \
		-D libunwind=disabled \
		-D lmsensors=enabled \
		-D valgrind=disabled \
		-D zstd=enabled \
		-D xlib-lease=disabled \
		-D video-codecs=all
		#-D cpp_rtti=false \
		#-D intel-clc=enabled \
		#vc1dec,h264dec,h264enc,h265dec,h265enc

	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
