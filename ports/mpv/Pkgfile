version = "0.39.0"
desc = 'a free, open source, and cross-platform media player'
deps = [
  "libdrm",
  "pipewire",
  "ffmpeg",
  "libarchive",
  "libplacebo",
  "mesa",
  "libglvnd",
  "luajit",
  "lcms2",
  "libjpeg-turbo",
  "libva",
  "vulkan",
  "wayland",
  "zlib",
]
makedeps = [
  "libdrm",
  "pipewire",
  "ffmpeg",
  "libarchive",
  "libplacebo",
  "mesa",
  "libglvnd",
  "luajit",
  "lcms2",
  "libjpeg-turbo",
  "libva",
  "vulkan-headers",
  "wayland-protocols",
  "zlib",
	"meson",
]
source = [
  { url = "https://github.com/mpv-player/mpv/archive/refs/tags/v${version}.tar.gz" },
]

build = '''
	noname-meson mpv-$version build --auto-features auto -Dgpl=true -Dmanpage-build=disabled
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
'''
