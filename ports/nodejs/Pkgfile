version="22.14.0"
makedeps=["zlib", "python3",  "openssl"]
deps=["zlib", "openssl"]
desc="Nodejs interpreter"
source=[
	{url="https://nodejs.org//dist/v${version}/node-v${version}.tar.gz"},
]

ext='''
	cd node-v$version
	for i in $source;do
		echo "### $i"
		case $i in
		*patch) patch -Nbp1 -i "$srcdir"/$i;;
		esac
	done
'''

build='''
	cd node-v$version
	sed -i -e "s;'-latomic',;;g" -e "s;'-latomic';;g" node.gyp tools/v8_gypfiles/v8.gyp
	export CFLAGS="$CFLAGS -Wno-enum-constexpr-conversion"
	export CXXFLAGS="$CXXFLAGS -Wno-enum-constexpr-conversion"
	GYP_DEFINES="linux_use_gold_flags=0 \
		linux_use_bundled_binutils=0 \
		linux_use_bundled_gold=0" \
	./configure --prefix=/ \
		--shared-zlib \
		--shared-openssl \
		--experimental-http-parser
	make
	make DESTDIR=$pkgdir install
'''
