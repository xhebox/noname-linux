version = "1.4.2"
desc = "library for layout and rendering of text"
deps = [
  "alsa-lib",
  "readline",
  "systemd",
  "dbus",
  "gstreamer",
  "ncurses",
  "libsndfile",
  "tinycompress",
  "vulkan",
  "bluez",
  "liblc3",
  "libfdk-aac",
  "ldac",
  "sbc",
  "libpulse",
]
makedeps = [
  "systemd",
  "dbus",
  "alsa-lib",
  "gstreamer",
  "ncurses",
  "libsndfile",
  "tinycompress",
  "vulkan",
  "vulkan-headers",
  "readline",
  "bluez",
  "liblc3",
  "libfdk-aac",
  "ldac",
  "sbc",
  "libpulse",
]
source = [
  { url = "https://github.com/PipeWire/pipewire/archive/refs/tags/$version.tar.gz" },
  { url = "pipewire.toml" },
]

build = '''
	noname-meson pipewire-$version build \
		-Dman=disabled \
		-Dgstreamer=enabled -Dgstreamer-device-provider=enabled \
		-Dbluez5-codec-ldac=enabled \
		-Dbluez5-codec-aac=enabled \
		-Dbluez5-codec-lc3=enabled \
		-Dbluez5-codec-lc3plus=disabled \
		-Dbluez5-codec-aptx=disabled \
		-Dcompress-offload=enabled \
		-Dlibmysofa=disabled \
		-Debur128=disabled \
		-Davahi=disabled \
		-Dsnap=disabled \
		-Dselinux=disabled \
		-Dx11=disabled \
		-Droc=disabled \
		-Dx11-xfixes=disabled \
		-Drlimits-install=false \
		-Dsession-managers=[] \
		-Djack=disabled \
		-Dlibcanberra=disabled \
		-Decho-cancel-webrtc=disabled \
		-Dlibcamera=disabled \
		-Dlv2=disabled \
		-Dlibffado=disabled \
		-Dsystemd-user-unit-dir=/lib/systemd/user
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
	install -Dm644 pipewire.toml "$pkgdir/${HOOKS#$ROOT}"/pipewire.toml
'''
