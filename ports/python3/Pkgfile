version="3.12.12"
pip_version="25.3"
wheel_version="0.45.1"
build_version="1.3.0"
installer_version="0.7.0"
packaging_version="25.0"
setuptools_version="80.9.0"
flitcore_version="3.12.0"
pyproject_hooks_version="1.2.0"
desc="A high-level scripting language(3.x)"
deps=["bzip2", "expat", "gdbm", "libffi", "sqlite", "openssl", "zlib", "mpdecimal"]
makedeps=["bzip2", "expat", "gdbm", "libffi", "sqlite", "openssl", "zlib", "mpdecimal"]
source=[
	{url="https://www.python.org/ftp/python/$version/Python-$version.tar.xz", name="python-$version.tar.xz"},
	{url="https://pypi.io/packages/source/p/pip/pip-${pip_version}.tar.gz"},
	{url="https://pypi.io/packages/source/b/build/build-${build_version}.tar.gz"},
	{url="https://pypi.io/packages/source/i/installer/installer-${installer_version}.tar.gz"},
	{url="https://pypi.io/packages/source/w/wheel/wheel-$wheel_version.tar.gz"},
	{url="https://pypi.io/packages/source/s/setuptools/setuptools-$setuptools_version.tar.gz"},
	{url="https://pypi.io/packages/source/f/flit_core/flit_core-$flitcore_version.tar.gz"},
	{url="https://pypi.io/packages/source/p/pyproject_hooks/pyproject_hooks-$pyproject_hooks_version.tar.gz"},
	{url="https://pypi.io/packages/source/p/packaging/packaging-$packaging_version.tar.gz"},
]

build='''
	cd "$srcdir/Python-$version"

	rm -rf Modules/expat \
	Modules/_ctypes/darwin* \
	Modules/_ctypes/libffi* \
	Modules/zlib

	./configure --prefix=/ \
		--exec-prefix=/ \
		--enable-shared \
		--with-threads \
		--with-computed-gotos \
		--with-sqlite \
		--enable-ipv6 \
		--enable-optimizations \
		--with-lto \
		--with-system-expat \
		--with-system-ffi \
		--with-system-libmpdec \
		--without-ensurepip \
		--enable-loadable-sqlite-extensions

	make EXTRA_CFLAGS="$CFLAGS"
	make DESTDIR="$pkgdir" EXTRA_CFLAGS="$CFLAGS" altinstall

	find $pkgdir -name "README*" -delete
	find $pkgdir -name "ChangeLog*" -delete
	find $pkgdir -name "TODO*" -delete
	find $pkgdir -name "NEWS*" -delete

	install -dm755 "${pkgdir}"/lib/python${version%.*}/Tools/i18n
	install -m755 Tools/i18n/msgfmt.py "${pkgdir}"/lib/python${version%.*}/Tools/i18n/
	install -m755 Tools/i18n/pygettext.py "${pkgdir}"/lib/python${version%.*}/Tools/i18n/
	install -dm755 "${pkgdir}"/lib/python${version%.*}/Tools/scripts
	install -m755 Tools/scripts/*py "${pkgdir}"/lib/python${version%.*}/Tools/scripts/


	export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$pkgdir/lib"
	export PYTHON_PATH="$pkgdir/lib/python${version%.*}"
	export PATH="$pkgdir/bin:$PATH"

	ln -s python${version%.*} 	"$pkgdir/bin/python3"
	ln -s python3               "${pkgdir}"/bin/python
	ln -s python${version%.*}-config  "${pkgdir}"/bin/python3-config
	ln -s idle3                 "${pkgdir}"/bin/idle
	ln -s pydoc3                "${pkgdir}"/bin/pydoc
	ln -s python${version%.*}.1 "${pkgdir}"/share/man/man1/python.1
	ln -s python-${version%.*}.pc  "${pkgdir}"/lib/pkgconfig/python3.pc

	python3 -m venv venv
	. venv/bin/activate
	pip install build installer flit_core wheel

	cd ../setuptools-$setuptools_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../wheel-$wheel_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../pip-$pip_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../build-$build_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../installer-$installer_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../flit_core-$flitcore_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl
	
	cd ../pyproject_hooks-$pyproject_hooks_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	cd ../packaging-$packaging_version
	python -m build -wn
	python -m installer --prefix= -d "$pkgdir" dist/*.whl

	sed -i "s;$pkgdir;/;g" "$pkgdir"/bin/pip*
'''
