name = "rust"
nostrip = true
version = "1.92.0"
_rust_dist_version = "1.92.0"
makedeps = [
  "libffi",
  "ncurses",
  "libxml2",
  "zlib",
  "llvm",
  "xz",
  "curl",
  "cmake",
  "python3",
  "execinfo",
]
deps = [
  "libffi",
  "ncurses",
  "libxml2",
  "zlib",
  "llvm",
  "curl",
  "xz",
  "execinfo",
]
source = [
	{ url = "https://static.rust-lang.org/dist/rustc-${version}-src.tar.gz" },
	{ url = "https://static.rust-lang.org/dist/rust-${_rust_dist_version}-x86_64-unknown-linux-musl.tar.xz" },
  { url = "need-ssp_nonshared.patch" },
  { url = "need-rpath.patch" },
  { url = "musl-fix-linux_musl_base.patch" },
  { url = "system-wasm-ld.patch" },
  { url = "noname.patch" },
  { url = "libexec.patch" },
]

ext = '''
	mkdir -p stage0/bin
	mkdir -p stage0/lib

	cd rust-${_rust_dist_version}-$TARGET
	find . -name manifest.in -delete
	cp -a rust-std-*/* ../stage0/
	cp -a rustc/* ../stage0/
	cp -a cargo/* ../stage0/
	cd -

	cd rustc-$version-src
	for i in $source; do
		echo $i
		case $i in
		*.patch) patch -Nbp1 -i ../$i;;
		esac
	done

	cat <<- EOF > config.toml
change-id = 140732

[target.$TARGET]
crt-static = false
llvm-config = "$ROOT/bin/llvm-config"

[target.wasm32-unknown-unknown]
sanitizers = false
profiler = false

[build]
tools=["cargo", "clippy", "rustdoc", "rustfmt", "analysis", "rust-analyzer-proc-macro-srv", "src", "rust-demangler"]
host=["$TARGET"]
build="$TARGET"
target=[
	"$TARGET",
	"wasm32-unknown-unknown",
]
docs=false
profiler=true
extended=true
sanitizers=false
vendor=true
locked-deps=true
full-bootstrap=false
local-rebuild=true
cargo="$srcdir/stage0/bin/cargo"
rustc="$srcdir/stage0/bin/rustc"

[install]
prefix="/"
libdir="lib"
mandir="share/man"

[rust]
deny-warnings = false
channel="stable"
lto="fat"
codegen-units = 1
codegen-units-std = 1
remap-debuginfo=false
rpath = false
frame-pointers = true
llvm-libunwind = "system"
lld = false
jemalloc = false
use-lld = "external"
llvm-bitcode-linker = false

[dist]
src-tarball=false
compression-formats = ["gz"]
compression-profile = "fast"

[llvm]
link-shared = false
static-libstdcpp = false
use-libcxx = true
download-ci-llvm=false
EOF
'''

build = '''
	unset CFLAGS CXXFLAGS LDFLAGS
	export LD_LIBRARY_PATH="$pkgdir/lib:$srcdir/stage0/lib"
	export PATH="$pkgdir/bin:$srcdir/stage0/bin:$PATH"
	export CARGO_HOME="$srcdir/.cargo"
	cd "$srcdir/rustc-$version-src"
	./x.py build
	DESTDIR="$pkgdir" ./x.py install
	rm -rf "$pkgdir"/lib/rustlib/manifest-*
	rm -rf "$pkgdir/lib/rustlib/install.log"
	rm -rf "$pkgdir/lib/rustlib/rust-installer-version"
'''
