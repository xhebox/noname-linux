version="musl-v257.8-split-usr"
desc="system and service manager"
makedeps=["acl", "gperf", "lz4", "xz", "pam", "elfutils", "nftables", "kmod", "libcap", "util-linux", "musl", "shadow", "gnu-efi-libs", "libseccomp", "pcre2", "libxkbcommon", "p11-kit", "hwdata"]
nocache=true
deps=["acl", "lz4", "xz", "pam", "elfutils", "nftables", "kmod", "libcap", "util-linux", "musl", "shadow", "gnu-efi-libs", "libseccomp", "pcre2", "libxkbcommon", "p11-kit", "hwdata"]
source=[
	{url="https://gitlab.postmarketos.org/postmarketOS/systemd/-/archive/$version/systemd-$version.tar.gz"},
	{url="noname.patch"},

	{url="initcpio-hook-udev"},
	{url="initcpio-install-systemd"},
	{url="initcpio-install-udev"},
	{url="noname.conf"},
	{url="loader.conf"},
	{url="systemd-user.pam"},
	{url="systemd-binfmt.toml"},
	{url="systemd-catalog.toml"},
	{url="systemd-daemon-reload.toml"},
	{url="systemd-hwdb.toml"},
	{url="systemd-sysctl.toml"},
	{url="systemd-sysusers.toml"},
	{url="systemd-tmpfiles.toml"},
	{url="systemd-udev-reload.toml"},
]
baks=[
	"etc/systemd/journald.conf",
	"etc/systemd/logind.conf",
	"etc/systemd/networkd.conf",
]

ext='''
	cd systemd-$version
	for i in $source; do
		echo "#### $i"
		case $i in
		*patch) patch -Nbp1 -i ../$i;;
		esac
	done
	sed -i \
	-e 's;CAP_BPF;;g' \
	units/*.service.in
'''

build='''
	python3 -m venv ss
	. ./ss/bin/activate
	pip install jinja2 pyelftools pefile
	export CFLAGS="$CFLAGS -D__UAPI_DEF_ETHHDR=0 -Wno-incompatible-pointer-types-discards-qualifiers"
	noname-meson systemd-$version build \
	-Dutmp=false \
	-Dman=disabled \
	-Dldconfig=false \
	-Dtests=false \
	-Defi=true \
	-Dbpf-framework=disabled \
	-Dpwquality=disabled \
	-Dpasswdqc=disabled \
	-Dselinux=disabled \
	-Dapparmor=disabled \
	-Daudit=disabled \
	-Dxenctrl=disabled \
	-Dfirstboot=false \
	-Dlibcurl=disabled \
	-Dimportd=disabled \
	-Dima=false \
	-Dlibidn2=disabled \
	-Dlibidn=disabled \
	-Didn=false \
	-Dlibcryptsetup=disabled \
	-Dlibcryptsetup-plugins=disabled \
	-Dqrencode=disabled \
	-Dgcrypt=disabled \
	-Dgnutls=disabled \
	-Dlibfido2=disabled \
	-Dtpm=false \
	-Dtpm2=disabled \
	-Dsplit-usr=true \
	-Dsplit-bin=false \
	-Dmicrohttpd=disabled \
	-Dgshadow=false \
	-Dlocaled=true \
	-Duserdb=true \
	-Dukify=enabled \
	-Dhomed=disabled \
	-Dremote=disabled \
	-Dbinfmt=true \
	-Dnss-resolve=disabled \
	-Dnss-myhostname=false \
	-Dnss-mymachines=disabled \
	-Dnss-systemd=false \
	-Dresolve=true \
	-Dhostnamed=false \
	-Dtimedated=true \
	-Dtimesyncd=true \
	-Dlz4=enabled \
	-Dpolkit=disabled \
	-Ddbuspolicydir=/share/dbus-1/system.d \
	-Ddefault-locale=C \
	-Ddefault-kill-user-processes=false \
	-Dfallback-hostname='PC' \
	-Dntp-servers="pool.ntp.org" \
	-Ddns-servers="1.1.1.1 223.5.5.5 119.29.29.29" \
	-Drpmmacrosdir=no \
	-Dsysvinit-path= \
	-Dsysvrcnd-path= \
	-Dsbat-distro=noname \
	-Dsbat-distro-url=https://github.com/xhebox/noname-linux

	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build

	install -D -m0644 -t "$pkgdir"/${HOOKS#$ROOT} *.toml

	install -D -m0644 noname.conf "$pkgdir"/share/systemd/bootctl/noname.conf
	install -D -m0644 loader.conf "$pkgdir"/share/systemd/bootctl/loader.conf

	install -D -m0644 systemd-user.pam "$pkgdir"/etc/pam.d/systemd-user

	install -D -m0644 initcpio-install-systemd "$pkgdir"/lib/initcpio/install/systemd
	install -D -m0644 initcpio-install-udev "$pkgdir"/lib/initcpio/install/udev
	install -D -m0644 initcpio-hook-udev "$pkgdir"/lib/initcpio/hooks/udev
'''
