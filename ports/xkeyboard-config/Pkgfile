version="2.46"
desc="X keyboard configuration database"
makedeps=["meson", "python3"]
source=[
	{url="https://xorg.freedesktop.org/releases/individual/data/xkeyboard-config/xkeyboard-config-$version.tar.xz"},
]

build='''
	noname-meson xkeyboard-config-$version build
	meson configure --no-pager build
	meson compile -C build
	DESTDIR="$pkgdir" meson install -C build
	ln -s /var/lib/xkb "$pkgdir"/share/xkb/compiled
'''
