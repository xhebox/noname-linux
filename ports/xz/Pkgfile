version="5.8.0"
desc="Compression utility using the lzma algorithm, successor of lzma-utils"
source=[
	{url="http://tukaani.org/xz/xz-$version.tar.gz"},
	{url="default-threading.patch"},
	{url="io-size.patch"},
	{url="speedup.patch"},
]

ext='''
	cd xz-$version
	for i in $source;do
		case $i in
		*.patch) patch -p1 -i "$srcdir"/"$i" ;;
		esac
	done
'''

build='''
	cd xz-$version
	./configure \
		--disable-rpath \
		--prefix= 
	make
	make DESTDIR="$pkgdir" install
'''
