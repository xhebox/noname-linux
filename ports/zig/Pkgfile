version="0.16.0"
desc="general-purpose programming language and toolchain for maintaining robust, optimal and reusable software."
nostrip=true
deps=["llvm"]
makedeps=["llvm", "cmake"]
source=[
	{url="https://codeberg.org/ziglang/zig/archive/$version.tar.gz"},
]

build='''
	export CXXFLAGS="$CXXFLAGS -stdlib=libc++"
	noname-cmake zig -Bbuild -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/ -DZIG_TARGET_MCPU=baseline -DZIG_SYSTEM_LIBCXX=c++ -DZIG_STATIC_ZLIB=on
	cmake --build build
	DESTDIR="${pkgdir}" cmake --build build --target install
'''
